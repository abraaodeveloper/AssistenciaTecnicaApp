<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AssistenciaTecnicaApp.App"
             xmlns:local="using:AssistenciaTecnicaApp"
             xmlns:converters="using:AssistenciaTecnicaApp.Converters"
             RequestedThemeVariant="Light">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Styles/Icons.axaml"/>
                <ResourceInclude Source="/Styles/Colors.axaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:IconConverter x:Key="IconConverter"/>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        
        <!-- Menu Principal Styles -->
        <Style Selector="TabControl.main-menu">
            <Setter Property="Background" Value="{DynamicResource BackgroundLightBrush}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="TabStripPlacement" Value="Top"/>
        </Style>

        <!-- Apenas para o WrapPanel do menu principal -->
        <Style Selector="TabControl.main-menu > WrapPanel">
            <Setter Property="Background" Value="{DynamicResource MenuBackgroundBrush}"/>
        </Style>

        <!-- Apenas para os TabItems do menu principal -->
        <Style Selector="TabControl.main-menu > TabItem">
            <Setter Property="Padding" Value="24 16"/>
            <Setter Property="Foreground" Value="{DynamicResource MenuTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource MenuBackgroundBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0 0 0 3"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Transitions">
                <Setter.Value>
                    <Transitions>
                        <BrushTransition Property="Background" Duration="0:0:0.2"/>
                        <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
                        <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                    </Transitions>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="TabControl.main-menu > TabItem:selected">
            <Setter Property="Background" Value="{DynamicResource MenuBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource MenuSelectedTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MenuSelectedTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="TabControl.main-menu > TabItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource PrimaryDarkBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MenuSelectedTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <!-- Estilos para o submenu -->
        <Style Selector="TabControl.main-menu TabControl">
            <Setter Property="Background" Value="{DynamicResource SubMenuBackgroundBrush}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0 0 0 1"/>
            <Setter Property="BorderBrush" Value="#20000000"/>
            <Setter Property="TabStripPlacement" Value="Top"/>
        </Style>
        
        <Style Selector="TabControl.main-menu TabControl > WrapPanel">
            <Setter Property="Background" Value="{DynamicResource SubMenuBackgroundBrush}"/>
        </Style>
        
        <Style Selector="TabControl.main-menu TabControl > TabItem">
            <Setter Property="Padding" Value="18 12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0 0 0 2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Transitions">
                <Setter.Value>
                    <Transitions>
                        <BrushTransition Property="Background" Duration="0:0:0.2"/>
                        <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
                        <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                    </Transitions>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style Selector="TabControl.main-menu TabControl > TabItem:selected">
            <Setter Property="Background" Value="{DynamicResource SubMenuBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        
        <Style Selector="TabControl.main-menu TabControl > TabItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource SecondaryColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryLightBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Application.Styles>
</Application>