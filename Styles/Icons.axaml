<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Ícone padrão usando o logo -->
    <StreamGeometry x:Key="logo">M10 10h80v80h-80z M50 60 AT</StreamGeometry>
    
    <!-- Aliases para usar o mesmo ícone em diferentes lugares -->
    <StreamGeometry x:Key="home_regular">{StaticResource logo}</StreamGeometry>
    <StreamGeometry x:Key="document_regular">{StaticResource logo}</StreamGeometry>
    <StreamGeometry x:Key="people_regular">{StaticResource logo}</StreamGeometry>
    <StreamGeometry x:Key="settings_regular">{StaticResource logo}</StreamGeometry>
    <StreamGeometry x:Key="add_regular">{StaticResource logo}</StreamGeometry>
    <StreamGeometry x:Key="list_regular">{StaticResource logo}</StreamGeometry>
    <StreamGeometry x:Key="search_regular">{StaticResource logo}</StreamGeometry>
    <StreamGeometry x:Key="dashboard_regular">{StaticResource logo}</StreamGeometry>
    <StreamGeometry x:Key="chart_regular">{StaticResource logo}</StreamGeometry>
    <StreamGeometry x:Key="store_regular">{StaticResource logo}</StreamGeometry>
</ResourceDictionary> 