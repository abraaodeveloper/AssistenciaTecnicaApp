<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AssistenciaTecnicaApp.ViewModels"
             x:Class="AssistenciaTecnicaApp.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    
    <Grid>
        <TabControl>
            <TabItem Header="Personalização">
                <Grid Margin="20">
                    <StackPanel Spacing="20" MaxWidth="600">
                        <TextBlock Text="Personalização" 
                                 FontSize="24" 
                                 FontWeight="SemiBold"/>
                        
                        <StackPanel Spacing="10">
                            <TextBlock Text="Tema" 
                                     FontSize="16" 
                                     FontWeight="SemiBold"/>
                            
                            <TextBlock Text="Selecione o tema da aplicação" 
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     Margin="0,0,0,10"/>
                            
                            <ListBox ItemsSource="{Binding ThemeConfig.AvailableThemes}"
                                   SelectedItem="{Binding SelectedTheme}"
                                   Background="Transparent"
                                   Margin="0,0,0,20">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                            <Border Grid.RowSpan="2" 
                                                  Width="30" 
                                                  Height="30" 
                                                  CornerRadius="15"
                                                  Background="{Binding ColorHex}"
                                                  Margin="0,0,15,0"/>
                                            
                                            <TextBlock Grid.Column="1" 
                                                     Grid.Row="0" 
                                                     Text="{Binding Name}" 
                                                     FontWeight="SemiBold"/>
                                            
                                            <TextBlock Grid.Column="1" 
                                                     Grid.Row="1" 
                                                     Text="{Binding Id}" 
                                                     FontSize="11"
                                                     Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            
                            <Button Command="{Binding SaveThemeCommand}"
                                  Content="Aplicar Tema"
                                  HorizontalAlignment="Left"
                                  Classes="accent"
                                  Padding="15,10"/>
                            
                            <TextBlock Text="{Binding StatusMessage}"
                                     Foreground="{Binding StatusMessageColor}"
                                     IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                        
                        <Border Height="1" 
                              Background="{DynamicResource DividerBrush}" 
                              Margin="0,10"/>
                        
                        <StackPanel Spacing="10">
                            <TextBlock Text="Sobre" 
                                     FontSize="16" 
                                     FontWeight="SemiBold"/>
                            
                            <TextBlock Text="Sistema de Assistência Técnica" 
                                     FontWeight="SemiBold"/>
                            
                            <TextBlock Text="© 2025 MatPhone - Assistência Técnica e Acessórios para Celulares"
                                     Foreground="{DynamicResource TextSecondaryBrush}"/>
                            
                            <TextBlock Text="Versão 1.0.0"
                                     Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>
            
            <TabItem Header="Usuários">
                <TextBlock Text="Gerenciamento de Usuários" 
                         FontSize="24" 
                         Margin="20" 
                         HorizontalAlignment="Center" 
                         VerticalAlignment="Center"/>
            </TabItem>
            
            <TabItem Header="Sistema">
                <TextBlock Text="Configurações do Sistema" 
                         FontSize="24" 
                         Margin="20" 
                         HorizontalAlignment="Center" 
                         VerticalAlignment="Center"/>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl> 