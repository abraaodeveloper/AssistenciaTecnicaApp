<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AssistenciaTecnicaApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="768"
        x:Class="AssistenciaTecnicaApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Sistema de Assistência Técnica"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Menu Principal -->
        <TabControl Grid.Row="0" 
                   Margin="0,5,10,0"
                   HorizontalAlignment="Right"
                   SelectedItem="{Binding SelectedMenuItem}"
                   ItemsSource="{Binding MenuItems}">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Vertical" Spacing="4">
                        <PathIcon Data="{Binding Icon, Converter={StaticResource IconConverter}}"
                                Width="24" Height="24"/>
                        <TextBlock Text="{Binding Name}"/>
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
        </TabControl>

        <!-- Submenu -->
        <Border Grid.Row="1" 
                Classes="submenu"
                Background="{DynamicResource SecondaryBrush}"
                Padding="10">
            <ItemsControl ItemsSource="{Binding CurrentSubmenuItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="20"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Classes="submenuButton">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{Binding Icon}"
                                        Width="16" Height="16"/>
                                <TextBlock Text="{Binding Name}"
                                         VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Área de conteúdo -->
        <ContentControl Grid.Row="2" 
                      Content="{Binding CurrentPage}"
                      Margin="20"/>
    </Grid>
</Window>
