<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AssistenciaTecnicaApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="using:Avalonia.Data.Converters"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
        x:Class="AssistenciaTecnicaApp.Views.LoginWindow"
        x:DataType="vm:LoginViewModel"
        Title="Login"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        SystemDecorations="None"
        Width="1000" Height="600"
        Background="White"
        PointerPressed="Window_PointerPressed">

    <Grid>
        <!-- Conteúdo Principal -->
        <Grid ColumnDefinitions="5*,4*">
            <!-- Lado Esquerdo - Imagem -->
            <Panel Grid.Column="0" 
                   Background="{DynamicResource LoginPanelBackgroundBrush}">
                <Image Source="/Assets/logo.png"
                       Width="400"
                       Height="400"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="0,0,0,0"
                       Opacity="0.9"/>
            </Panel>

            <!-- Lado Direito - Formulário -->
            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Width="300"
                        Margin="40,0,0,0"
                        Spacing="20">
                
                <StackPanel Spacing="8">
                    <TextBlock Text="Sign in"
                             FontSize="24"
                             FontWeight="SemiBold"
                             Foreground="#1E1E1E"/>
                    <TextBlock Text="Entre com suas credenciais"
                             Foreground="#666666"/>
                </StackPanel>

                <!-- Campos de Login -->
                <StackPanel Spacing="15">
                    <TextBox Text="{Binding Email}"
                             Watermark="Email"
                             Height="40"
                             CornerRadius="4"
                             Background="{DynamicResource InputBackgroundBrush}"
                             BorderThickness="1"
                             BorderBrush="{DynamicResource InputBorderBrush}"
                             VerticalContentAlignment="Center">
                        <TextBox.Styles>
                            <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
                                <Setter Property="BorderBrush" Value="{DynamicResource InputFocusBorderBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </Style>
                            <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
                                <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </Style>
                        </TextBox.Styles>
                    </TextBox>

                    <TextBox Text="{Binding Senha}"
                             Watermark="Senha"
                             PasswordChar="●"
                             Height="40"
                             CornerRadius="4"
                             Background="{DynamicResource InputBackgroundBrush}"
                             BorderThickness="1"
                             BorderBrush="{DynamicResource InputBorderBrush}"
                             VerticalContentAlignment="Center">
                        <TextBox.Styles>
                            <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
                                <Setter Property="BorderBrush" Value="{DynamicResource InputFocusBorderBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </Style>
                            <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
                                <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </Style>
                        </TextBox.Styles>
                    </TextBox>

                    <Button Command="{Binding LoginCommand}"
                            Content="Entrar"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Height="40"
                            CornerRadius="4"
                            Background="{DynamicResource ButtonPrimaryBackgroundBrush}"
                            Foreground="{DynamicResource ButtonPrimaryTextBrush}">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="{DynamicResource ButtonPrimaryHoverBrush}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Style>
                        </Button.Styles>
                        <Button.IsEnabled>
                            <Binding Path="IsLoading" Converter="{x:Static BoolConverters.Not}"/>
                        </Button.IsEnabled>
                    </Button>
                </StackPanel>

                <!-- Indicador de carregamento -->
                <ProgressBar IsVisible="{Binding IsLoading}"
                            IsIndeterminate="True"
                            Height="4"
                            Margin="0,10,0,0"/>

                <!-- Mensagem de erro -->
                <TextBlock Text="{Binding ErrorMessage}"
                         Foreground="Red"
                         TextWrapping="Wrap"
                         IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </Grid>

        <!-- Botões de Controle (Flutuantes) -->
        <StackPanel HorizontalAlignment="Right" 
                    VerticalAlignment="Top"
                    Orientation="Horizontal" 
                    Margin="0,5,5,0"
                    IsHitTestVisible="True">
            <Button Width="46"
                    Height="30"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="0"
                    Padding="0"
                    VerticalContentAlignment="Center"
                    HorizontalContentAlignment="Center"
                    Click="MinimizeButton_Click">
                <Path Data="M2048 1229v-205h-2048v205h2048z"
                      Width="11" Height="11"
                      Fill="#666666"
                      Stretch="Uniform"/>
            </Button>
            
            <Button Width="46"
                    Height="30"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="0"
                    Padding="0"
                    VerticalContentAlignment="Center"
                    HorizontalContentAlignment="Center"
                    Click="CloseButton_Click"
                    Name="CloseButton">
                <Path Data="M1169 1024l879 -879l-145 -145l-879 879l-879 -879l-145 145l879 879l-879 879l145 145l879 -879l879 879l145 -145z"
                      Width="11" Height="11"
                      Fill="#666666"
                      Stretch="Uniform"/>
            </Button>
        </StackPanel>
    </Grid>
</Window> 